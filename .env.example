# Supabase — safe to expose client-side; access is governed by RLS, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://rkedknimzyqeliswuiqz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET — bypasses Row-Level Security. Server-only (Server Actions/route
# handlers), never prefix with NEXT_PUBLIC_. Required for the Super Admin
# portal (/super-admin) since it has no auth session yet to satisfy RLS.
# Get it from Supabase Dashboard -> Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Demo safety net. When "true", the public cars/gallery pages serve the
# bundled demo catalogue (src/data/demo/*) if Supabase can't be reached.
# Server-only (no NEXT_PUBLIC_ prefix). Read-only public content only —
# contact forms, leads, uploads and admin writes still fail honestly.
# On Vercel: set it under Settings -> Environment Variables for Production
# (and Preview if wanted), then REDEPLOY — the homepage is prerendered at
# build time, so the value must be present during the build.
# Temporary demo configuration, not a substitute for a working backend:
# leave unset in production once real inventory is live.
DEMO_DATA_FALLBACK=
